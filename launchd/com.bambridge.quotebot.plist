<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.bambridge.quotebot</string>
  <key>ProgramArguments</key>
  <array>
    <string>__REPO__/venv/bin/python</string>
    <string>-m</string>
    <string>quotebot.main</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <!-- Interactive so it runs in the user's GUI session (needed for Computer
       Use to see the screen and drive Chrome). -->
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__REPO__/logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO__/logs/launchd.err.log</string>
</dict>
</plist>
